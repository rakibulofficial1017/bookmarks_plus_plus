{
    "manifest_version": 3,
    "name": "Bookmarks++",
    "version": "3.0",
    "description": "Easily log, organize, and manage your visited websites and active browser tabs with custom names.",
    "action": {
        "default_popup": "index.html",
        "default_title": "Bookmarks++"
    },
    "permissions": [
        "tabs"
    ],
    "icons": {
        "16": "icons/icon16.png",
        "32": "icons/icon32.png",
        "48": "icons/icon48.png",
        "128": "icons/icon128.png",
        "192": "icons/icon192.png",
        "256": "icons/icon256.png",
        "512": "icons/icon512.png"
    }
}